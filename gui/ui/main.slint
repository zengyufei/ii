                                        Rectangle { visible: root.has-selected-task; x: 0px; y: 168px; width: 80px; height: 16px; Text { text: "当前进度"; color: #66747b; font-size: 12px; } }
                                        Text { visible: root.has-selected-task; x: 105px; y: 168px; width: 198px; text: root.detail-progress; color: #1c282d; font-size: 12px; font-weight: 600; overflow: elide; }
                                        Rectangle { visible: root.has-selected-task; x: 0px; y: 192px; width: 80px; height: 16px; Text { text: "开始时间"; color: #66747b; font-size: 12px; } }
                                        Text { visible: root.has-selected-task; x: 105px; y: 192px; width: 198px; text: root.detail-time; color: #1c282d; font-size: 12px; font-weight: 600; overflow: elide; }
                                        Rectangle { visible: root.has-selected-task; x: 0px; y: 216px; width: 80px; height: 16px; Text { text: "目标位置"; color: #66747b; font-size: 12px; } }
