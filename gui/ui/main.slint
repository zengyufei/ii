                                            Rectangle { height: 50px; Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #d5dedf; } HorizontalLayout { padding-left: 15px; padding-right: 15px; Text { text: "当前路径"; color: #1c282d; font-size: 16px; font-weight: 400; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: "发送 project-backup.zip"; color: #66747b; font-size: 12px; vertical-alignment: center; } } }
                                            VerticalLayout {
                                                padding: 15px;
                                                spacing: 0px;
                                                Rectangle { height: 58px; Rectangle { x: 9px; y: 22px; width: 1px; height: 36px; background: #b9c9c8; } Rectangle { x: 0px; y: 0px; width: 20px; height: 20px; border-radius: 10px; background: #08766f; Text { width: parent.width; height: parent.height; text: "1"; color: #ffffff; font-size: 11px; font-weight: 400; horizontal-alignment: center; vertical-alignment: center; } } Text { x: 40px; y: 0px; width: parent.width - 40px; height: 18px; text: "本机端点"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 40px; y: 20px; width: parent.width - 40px; height: 17px; text: "已绑定，等待接收方连接"; color: #66747b; font-size: 12px; } }
                                                Rectangle { height: 58px; Rectangle { x: 9px; y: 22px; width: 1px; height: 36px; background: #b9c9c8; } Rectangle { x: 0px; y: 0px; width: 20px; height: 20px; border-radius: 10px; background: #08766f; Text { width: parent.width; height: parent.height; text: "2"; color: #ffffff; font-size: 11px; font-weight: 400; horizontal-alignment: center; vertical-alignment: center; } } Text { x: 40px; y: 0px; width: parent.width - 40px; height: 18px; text: "直接连接尝试"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 40px; y: 20px; width: parent.width - 40px; height: 17px; text: "预计 3 秒内完成快速路径检测"; color: #66747b; font-size: 12px; } }
                                                Rectangle { height: 39px; Rectangle { x: 0px; y: 0px; width: 20px; height: 20px; border-radius: 10px; background: #08766f; Text { width: parent.width; height: parent.height; text: "3"; color: #ffffff; font-size: 11px; font-weight: 400; horizontal-alignment: center; vertical-alignment: center; } } Text { x: 40px; y: 0px; width: parent.width - 40px; height: 18px; text: "HTTPS 中继回退"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 40px; y: 20px; width: parent.width - 40px; height: 17px; text: "仅在直连不可用时启用"; color: #66747b; font-size: 12px; } }
                                                Rectangle { height: 12px; }
                                                Rectangle { height: 36px; background: #fff8f5; Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: #b6532d; } Text { x: 10px; y: 10px; width: parent.width - 18px; height: 16px; text: "这是状态解释，不会从此页面启动或托管 Relay 服务。"; color: #5d514b; font-size: 12px; wrap: word-wrap; } }
                                                Rectangle { vertical-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 138px;
                                    background: #ffffff;
                                    border-color: #d5dedf;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    drop-shadow-blur: 10px;
                                    drop-shadow-color: #1c282d18;
                                    drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        spacing: 0px;
                                        Rectangle { height: 52px; Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #d5dedf; } HorizontalLayout { padding-left: 15px; padding-right: 15px; Text { text: "诊断日志摘录"; color: #1c282d; font-size: 16px; font-weight: 400; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: "仅演示文本"; color: #66747b; font-size: 12px; vertical-alignment: center; } } }
                                        Rectangle { vertical-stretch: 1; background: #1d2a30; Text { x: 15px; y: 15px; width: parent.width - 30px; height: parent.height - 30px; text: "12:42:03   已完成  端点初始化\n12:42:03   已完成  默认中继可达，延迟 72 ms\n12:42:04   提示    未发现可用局域网地址"; color: #dfe9e8; font-size: 12px; vertical-alignment: top; } }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    visible: root.page == 3;
                    width: parent.width;
                    height: parent.height;
                    background: #ffffff;
                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;
                        Rectangle {
                            height: 106px;
                            background: #f7f9f9;
                            border-width: 0px;
                            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #d5dedf; }
                            Text { x: 22px; y: 19px; text: "应用偏好"; color: #08766f; font-size: 11px; font-weight: 400; }
                            Text { x: 22px; y: 39px; text: "设置"; color: #1c282d; font-size: 20px; font-weight: 400; }
                            Text { x: 22px; y: 70px; text: "管理界面、接收行为、发送策略和本地队列数据库。"; color: #66747b; font-size: 12px; }
                            Button { x: parent.width - 102px; y: 54px; width: 80px; height: 34px; text: "恢复默认"; clicked => { root.settings-section = 0; root.setting-check-incomplete = true; root.setting-close-to-tray = false; root.setting-open-directory = false; root.status-text = "已恢复默认设置。"; } }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: #ffffff;
                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 0px;
                                Rectangle {
                                    width: 240px;
                                    vertical-stretch: 1;
                                    background: #fbfcfc;
                                    border-color: #d5dedf;
                                    border-width: 1px;
                                    VerticalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { height: 16px; vertical-stretch: 0; text: "设置分类"; color: #66747b; font-size: 11px; font-weight: 400; }
                                        Rectangle { height: 2px; }
                                        SettingsNavButton { text: "通用"; icon: "A"; active: root.settings-section == 0; clicked => { root.settings-section = 0; root.status-text = "通用设置。"; } }
                                        SettingsNavButton { text: "接收"; icon: "↓"; active: root.settings-section == 1; clicked => { root.settings-section = 1; root.status-text = "接收设置。"; } }
                                        SettingsNavButton { text: "传输"; icon: "↗"; active: root.settings-section == 2; clicked => { root.settings-section = 2; root.status-text = "传输设置。"; } }
                                        SettingsNavButton { text: "外观"; icon: "◐"; active: root.settings-section == 3; clicked => { root.settings-section = 3; root.status-text = "外观设置。"; } }
                                        SettingsNavButton { text: "本地数据"; icon: "DB"; active: root.settings-section == 4; clicked => { root.settings-section = 4; root.status-text = "SQLite 保存传输队列与任务详情。"; } }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                }
                                ScrollView {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        padding-left: 24px;
                                        padding-right: 24px;
                                        padding-top: 20px;
                                        padding-bottom: 20px;
                                        spacing: 0px;
                                        Rectangle {
                                            visible: root.settings-section == 0;
                                            height: root.settings-section == 0 ? 338px : 0px;
                                            VerticalLayout {
                                                spacing: 0px;
                                                SettingsPaneHeader { title: "通用"; subtitle: "应用启动与本机基础行为。"; save => { root.status-text = "已保存通用设置。"; } }
                                                Rectangle { height: 16px; }
                                                Rectangle { height: 19px; Text { width: parent.width; height: parent.height; text: "启动"; color: #1c282d; font-size: 14px; font-weight: 400; vertical-alignment: center; } }
                                                Rectangle { height: 11px; }
                                                SettingsToggleRow { title: "启动时检查未完成任务"; subtitle: "发现 SQLite 队列中的中断任务时显示恢复入口。"; checked <=> root.setting-check-incomplete; }
                                                SettingsToggleRow { title: "关闭到托盘"; subtitle: "关闭窗口后保留后台传输进程。"; checked <=> root.setting-close-to-tray; }
                                                Rectangle { height: 1px; background: #d5dedf; }
                                                Rectangle { height: 22px; }
                                                Rectangle { height: 16px; Text { width: parent.width; height: parent.height; text: "设置会保存到本机配置。"; color: #66747b; font-size: 12px; vertical-alignment: center; } }
                                            }
                                        }
                                        Rectangle {
                                            visible: root.settings-section == 1;
                                            height: root.settings-section == 1 ? 280px : 0px;
                                            VerticalLayout {
                                                spacing: 0px;
                                                SettingsPaneHeader { title: "接收"; subtitle: "接收完成后的本机界面动作。"; save => { root.status-text = "已保存接收设置。"; } }
                                                Rectangle { height: 16px; }
                                                Rectangle { height: 19px; Text { width: parent.width; height: parent.height; text: "完成动作"; color: #1c282d; font-size: 14px; font-weight: 400; vertical-alignment: center; } }
                                                Rectangle { height: 11px; }
                                                SettingsToggleRow { title: "完成后打开目录"; subtitle: "成功接收后在文件管理器显示结果。"; checked <=> root.setting-open-directory; }
                                                Rectangle { height: 1px; background: #d5dedf; }
                                                Rectangle { vertical-stretch: 1; }
                                                Text { text: "保存目录由每个接收任务单独选择。"; color: #66747b; font-size: 12px; }
                                            }
                                        }
                                        Rectangle {
                                            visible: root.settings-section == 2;
                                            height: root.settings-section == 2 ? 280px : 0px;
                                            VerticalLayout {
                                                spacing: 0px;
                                                SettingsPaneHeader { title: "传输"; subtitle: "发送任务的生命周期和可见性。"; save => { root.status-text = "已保存传输设置。"; } }
                                                Rectangle { height: 16px; }
                                                Rectangle { height: 19px; Text { width: parent.width; height: parent.height; text: "传输码"; color: #1c282d; font-size: 14px; font-weight: 400; vertical-alignment: center; } }
                                                Rectangle { height: 11px; }
                                                Rectangle { height: 57px; Text { x: 0px; y: 7px; width: parent.width - 240px; height: 18px; text: "传输码有效期"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 0px; y: 28px; width: parent.width - 240px; height: 17px; text: "仅影响发送页新建的传输码。"; color: #66747b; font-size: 12px; } ComboBoxField { x: parent.width - 220px; y: 12px; width: 220px; values: ["24 小时", "1 小时", "直到手动停止"]; } }
                                                Rectangle { height: 1px; background: #d5dedf; }
                                                Rectangle { vertical-stretch: 1; }
                                                Text { text: "发送方式、配置和保持发送均在创建传输时选择。"; color: #66747b; font-size: 12px; }
                                            }
                                        }
                                        Rectangle {
                                            visible: root.settings-section == 3;
                                            height: root.settings-section == 3 ? 390px : 0px;
                                            VerticalLayout {
                                                spacing: 0px;
                                                SettingsPaneHeader { title: "外观"; subtitle: "显示语言、主题和任务列表密度。"; save => { root.status-text = "已保存外观设置。"; } }
                                                Rectangle { height: 16px; }
                                                Rectangle { height: 19px; Text { width: parent.width; height: parent.height; text: "界面"; color: #1c282d; font-size: 14px; font-weight: 400; vertical-alignment: center; } }
                                                Rectangle { height: 11px; }
                                                Rectangle { height: 57px; Text { x: 0px; y: 7px; width: parent.width - 240px; height: 18px; text: "显示语言"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 0px; y: 28px; width: parent.width - 240px; height: 17px; text: "重启应用后生效。"; color: #66747b; font-size: 12px; } ComboBoxField { x: parent.width - 220px; y: 12px; width: 220px; values: ["简体中文", "English"]; } }
                                                Rectangle { height: 57px; Text { x: 0px; y: 7px; width: parent.width - 240px; height: 18px; text: "主题"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 0px; y: 28px; width: parent.width - 240px; height: 17px; text: "默认跟随操作系统设置。"; color: #66747b; font-size: 12px; } ComboBoxField { x: parent.width - 220px; y: 12px; width: 220px; values: ["跟随系统", "浅色", "深色"]; } }
                                                Rectangle { height: 57px; Text { x: 0px; y: 7px; width: parent.width - 240px; height: 18px; text: "任务列表密度"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 0px; y: 28px; width: parent.width - 240px; height: 17px; text: "影响传输队列的单行高度。"; color: #66747b; font-size: 12px; } ComboBoxField { x: parent.width - 220px; y: 12px; width: 220px; values: ["紧凑", "标准"]; } }
                                                Rectangle { vertical-stretch: 1; }
                                            }
                                        }
                                        Rectangle {
                                            visible: root.settings-section == 4;
                                            height: root.settings-section == 4 ? 430px : 0px;
                                            VerticalLayout {
                                                spacing: 0px;
                                                SettingsPaneHeader { title: "本地数据"; subtitle: "SQLite 保存传输队列、任务状态和右侧详情记录。"; save => { root.status-text = "已保存本地数据设置。"; } }
                                                Rectangle { height: 16px; }
                                                Rectangle { height: 19px; Text { width: parent.width; height: parent.height; text: "SQLite 队列数据库"; color: #1c282d; font-size: 14px; font-weight: 400; vertical-alignment: center; } }
                                                Rectangle { height: 11px; }
                                                Rectangle {
                                                    height: 65px;
                                                    HorizontalLayout {
                                                        width: parent.width;
                                                        height: parent.height;
                                                        spacing: 8px;
                                                    Rectangle { horizontal-stretch: 1; height: 65px; background: #eff9f7; border-color: #9fcfc8; border-width: 1px; border-radius: 5px; drop-shadow-blur: 8px; drop-shadow-color: #1c282d14; VerticalLayout { padding: 10px; spacing: 2px; Text { text: "数据库状态"; color: #66747b; font-size: 12px; } Text { text: "可用"; color: #005f59; font-size: 16px; font-weight: 400; } } }
                                                    Rectangle { horizontal-stretch: 1; height: 65px; background: #fbfcfc; border-color: #d5dedf; border-width: 1px; border-radius: 5px; drop-shadow-blur: 8px; drop-shadow-color: #1c282d14; VerticalLayout { padding: 10px; spacing: 2px; Text { text: "当前记录"; color: #66747b; font-size: 12px; } Text { text: root.database-summary; color: #1c282d; font-size: 14px; font-weight: 400; overflow: elide; } } }
                                                    Rectangle { horizontal-stretch: 1; height: 65px; background: #fbfcfc; border-color: #d5dedf; border-width: 1px; border-radius: 5px; drop-shadow-blur: 8px; drop-shadow-color: #1c282d14; VerticalLayout { padding: 10px; spacing: 2px; Text { text: "队列存储"; color: #66747b; font-size: 12px; } Text { text: "SQLite"; color: #1c282d; font-size: 16px; font-weight: 400; } } }
                                                    }
                                                }
                                                Rectangle { height: 15px; }
                                                Rectangle { height: 62px; Text { x: 0px; y: 6px; width: parent.width - 440px; height: 18px; text: "数据库文件"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 0px; y: 27px; width: parent.width - 440px; height: 17px; text: "传输队列和任务详情的唯一持久化来源。"; color: #66747b; font-size: 12px; } TextField { x: parent.width - 420px; y: 15px; width: 353px; text: root.database-path; read-only: true; } Button { x: parent.width - 60px; y: 15px; width: 60px; height: 32px; text: "打开目录"; clicked => { root.status-text = "数据库目录：" + root.database-path; } }
                                                }
                                                Rectangle { height: 62px; Text { x: 0px; y: 6px; width: parent.width - 240px; height: 18px; text: "已完成记录保留"; color: #1c282d; font-size: 13px; font-weight: 400; } Text { x: 0px; y: 27px; width: parent.width - 240px; height: 17px; text: "超过保留期限的完成任务会在清理时删除。"; color: #66747b; font-size: 12px; } ComboBoxField { x: parent.width - 220px; y: 15px; width: 220px; values: ["30 天", "7 天", "永久保留"]; } }
                                                Rectangle { height: 14px; }
                                                Rectangle { height: 34px; HorizontalLayout { width: parent.width; height: parent.height; spacing: 7px; Button { width: 106px; height: 34px; text: "清理已完成记录"; clicked => { root.clear-completed(); } } Button { width: 76px; height: 34px; text: "整理数据库"; clicked => { root.compact-database(); } } DangerButton { width: 128px; height: 34px; text: "删除全部传输历史"; clicked => { root.request-clear-history(); } } Rectangle { horizontal-stretch: 1; } } }
                                                Rectangle { vertical-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                visible: false;
                height: 0px;
                background: #ffffff;
                border-color: #d5dedf;
                border-width: 1px;
                Text { x: 14px; text: root.status-text; color: #66747b; font-size: 11px; vertical-alignment: center; }
            }
    }

    Rectangle {
        visible: root.confirm-clear-history;
        width: parent.width;
        height: parent.height;
        background: #1c282d55;
        Rectangle {
            width: 390px;
            height: 174px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-color: #d5dedf;
            border-width: 1px;
            border-radius: 7px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #1c282d33;
            drop-shadow-offset-y: 5px;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "删除全部传输历史？"; color: #1c282d; font-size: 17px; font-weight: 800; }
                Text { text: "任务、传输码和详情记录会从本机 SQLite 队列中移除。"; color: #4f6067; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "取消"; clicked => { root.confirm-clear-history = false; } }
                    Button { text: "确认删除"; primary: true; clicked => { root.clear-history(); } }
                }
            }
        }
    }
}
