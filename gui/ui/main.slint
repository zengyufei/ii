                                                        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #d5dedf; }
                                                        HorizontalLayout { padding-left: 18px; padding-right: 18px; spacing: 11px; Rectangle { width: 399px; height: 58px; VerticalLayout { y: 10px; height: 35px; spacing: 1px; Text { text: task.name; color: #1c282d; font-size: 13px; font-weight: 400; overflow: elide; } Text { text: task.destination; color: #66747b; font-size: 11px; overflow: elide; } } } Text { text: task.direction; width: 78px; color: #1c282d; font-size: 12px; vertical-alignment: center; } Text { text: task.method; width: 90px; color: #1c282d; font-size: 12px; vertical-alignment: center; overflow: elide; } Rectangle { width: 88px; StatusTag { x: 0px; y: 17px; text: task.status; state: task.status == "传输中" ? "active" : task.status == "已完成" ? "done" : "waiting"; } } Rectangle { horizontal-stretch: 1; height: 58px; VerticalLayout { y: 14px; height: 30px; spacing: 4px; Rectangle { visible: task.status != "等待中"; height: 6px; border-radius: 3px; background: #dfe8e8; Rectangle { width: task.status == "已完成" ? parent.width : task.status == "传输中" ? parent.width * 0.62 : 0px; height: parent.height; background: #08766f; border-radius: 3px; } } Text { text: task.progress; color: #66747b; font-size: 11px; } } } Text { text: task.status == "传输中" ? "取消" : task.status == "已完成" ? "打开" : "查看"; width: 58px; color: #08766f; font-size: 12px; font-weight: 760; vertical-alignment: center; } }
