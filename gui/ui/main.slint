import { CheckBox, ComboBox, LineEdit as NativeLineEdit, TextEdit, ScrollView } from "std-widgets.slint";

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <length> text-size: 12px;
    callback clicked();
    min-width: 58px;
    height: 32px;
    vertical-stretch: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.primary ? #08766f : #d5dedf;
    background: root.primary ? (touch.has-hover ? #06655f : #08766f) : (touch.has-hover ? #f0f5f5 : #ffffff);
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.primary ? #ffffff : #1c282d;
        font-size: root.text-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component WindowButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();
    width: 32px;
    height: 32px;
    vertical-stretch: 0;
    border-width: 0px;
    border-radius: 4px;
    background: touch.has-hover ? (root.danger ? #c73b3b : #e8eeee) : #ffffff;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1c;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: touch.has-hover && root.danger ? #ffffff : #66747b;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// Keep the title-bar glyph and pointer region in this component's local space.
// Hand-writing one coordinate for the background and another for the glyph makes
// the visible control drift away from the clickable area.
component TitleBarButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();
    width: 42px;
    height: 48px;
    vertical-stretch: 0;
    border-width: 0px;
    border-radius: 0px;
    background: touch.has-hover ? (root.danger ? #c4523c : #e8eeee) : #00000000;

    Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #d5dedf; }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: touch.has-hover && root.danger ? #ffffff : #1c282d;
        font-size: root.danger ? 18px : 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component ListButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();
    height: 32px;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 0px;
    background: root.primary ? #08766f : (touch.has-hover ? #edf3f3 : #ffffff);
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.primary ? #ffffff : #1c282d;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component TextAction inherits Rectangle {
    in property <string> text;
    in property <int> text-weight: 730;
    callback clicked();
    height: 30px;
    vertical-stretch: 0;
    border-width: 0px;
    border-radius: 4px;
    background: touch.has-hover ? #edf2f2 : #ffffff;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #08766f;
        font-size: 12px;
        font-weight: root.text-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component SettingsNavButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active: false;
    callback clicked();
    height: 38px;
    vertical-stretch: 0;
    border-width: 0px;
    border-radius: 4px;
    background: root.active ? #eaf6f4 : (touch.has-hover ? #eef4f3 : #00000000);
    Rectangle {
        x: 10px;
        y: 9px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.active ? #08766f : #9aadae;
        Text {
            width: parent.width;
            height: parent.height;
            text: root.icon;
            color: #ffffff;
            font-size: root.icon == "DB" ? 8px : 10px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 39px;
        width: parent.width - 49px;
        height: parent.height;
        text: root.text;
        color: root.active ? #005f59 : #4c5d64;
        font-size: 13px;
        font-weight: 400;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component SettingsPaneHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    callback save();
    height: 61px;
    vertical-stretch: 0;
    border-width: 0px;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #d5dedf; }
    Text { x: 0px; y: 0px; text: root.title; color: #1c282d; font-size: 19px; font-weight: 400; }
    Text { x: 0px; y: 28px; text: root.subtitle; color: #66747b; font-size: 12px; }
    Button { x: parent.width - 82px; y: 0px; width: 82px; height: 34px; text: "保存更改"; primary: true; clicked => { root.save(); } }
}

component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width: 112px;
    height: 32px;
    vertical-stretch: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: #efb9ad;
    background: touch.has-hover ? #f9e6dc : #fff7f4;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #b6532d;
        font-size: 12px;
        font-weight: 760;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component SectionDivider inherits Rectangle {
    height: 17px;
    background: #00000000;
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #d5dedf;
    }
}

component ProfileSectionDivider inherits Rectangle {
    height: 18px;
    vertical-stretch: 0;
    background: #00000000;
    Rectangle {
        width: parent.width;
        height: 1px;
        background: #d5dedf;
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();
    width: 46px;
    height: 48px;
    border-width: 0px;
    background: touch.has-hover ? #edf2f2 : #00000000;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? #08766f : #66747b;
        font-size: root.active ? 13.75px : 14px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        visible: root.active;
        x: 9px;
        y: parent.height - 2px;
        width: parent.width - 18px;
        height: 2px;
        background: #08766f;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component GithubButton inherits Rectangle {
    callback clicked();
    width: 29px;
    height: 29px;
    border-radius: 4px;
    border-width: 0px;
    background: touch.has-hover ? #edf2f2 : #00000000;
    Image { x: 6px; y: 6px; width: 17px; height: 17px; source: @image-url("github.svg"); }
    touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

component HeaderThemeButton inherits Rectangle {
    callback clicked();
    width: 74px;
    height: 32px;
    border-width: 0px;
    border-radius: 4px;
    background: touch.has-hover ? #edf2f2 : #fbfcfc;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: "系统主题";
        color: #4c5d64;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

component ModeButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <int> text-weight: 600;
    callback clicked();
    height: 27px;
    min-width: 54px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.active ? #08766f : #d5dedf;
    background: root.active ? #d9f0ec : #ffffff;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? #005f59 : #4e5e65;
        font-size: 12px;
        font-weight: root.text-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component DestinationButton inherits Rectangle {
    in property <string> text;
    in property <int> text-weight: 800;
    callback clicked();
    width: 48px;
    height: 32px;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: #08766f;
    background: touch.has-hover ? #c5e6e0 : #d9f0ec;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #005f59;
        font-size: 12px;
        font-weight: root.text-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    height: 22px;
    width: 38px;
    vertical-stretch: 0;
    border-width: 0px;
    border-radius: 12px;
    background: root.checked ? #08766f : #aebbbc;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.checked = !root.checked; }
    }
}

component SettingsToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in-out property <bool> checked;
    height: 57px;
    vertical-stretch: 0;
    Rectangle {
        width: parent.width - 38px;
        height: parent.height;
        Text { x: 0px; y: 6px; width: parent.width; height: 18px; text: root.title; color: #1c282d; font-size: 13px; font-weight: 400; }
        Text { x: 0px; y: 27px; width: parent.width; height: 17px; text: root.subtitle; color: #66747b; font-size: 12px; }
    }
    Toggle { x: parent.width - 38px; y: 17px; checked <=> root.checked; }
}

component StatusTag inherits Rectangle {
    in property <string> text;
    in property <string> state: "waiting";
    width: 72px;
    height: 24px;
    vertical-stretch: 0;
    border-width: 0px;
    border-radius: 12px;
    background: root.state == "active" ? #d9f0ec : root.state == "done" ? #e8eeee : #fbefc9;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.state == "active" ? #005f59 : root.state == "done" ? #54636a : #8a6507;
        font-size: 12px;
        font-weight: 760;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <bool> read-only: false;
    in property <bool> password: false;
    in property <bool> shadow-enabled: true;
    height: 32px;
    background: #ffffff;
    drop-shadow-blur: root.shadow-enabled ? 7px : 0px;
    drop-shadow-color: root.shadow-enabled ? #1c282d1f : #00000000;
    drop-shadow-offset-y: 2px;
    NativeLineEdit {
        width: parent.width;
        height: parent.height;
        text <=> root.text;
        placeholder-text: root.placeholder-text;
        read-only: root.read-only;
        input-type: root.password ? InputType.password : InputType.text;
    }
}

component ComboBoxField inherits Rectangle {
    in property <[string]> values;
    in-out property <string> current-value;
    height: 32px;
    vertical-stretch: 0;
    background: #ffffff;
    drop-shadow-blur: 7px;
    drop-shadow-color: #1c282d1f;
    drop-shadow-offset-y: 2px;
    ComboBox {
        width: parent.width;
        height: parent.height;
        model: root.values;
        current-value <=> root.current-value;
    }
}

component SendFormLabel inherits Text {
    width: 70px;
    vertical-stretch: 1;
    color: #66747b;
    font-size: 12px;
    vertical-alignment: center;
}

component SendProfileField inherits Rectangle {
    in property <string> label;
    in property <[string]> values;
    in-out property <string> current-value;
    callback manage-config();
    height: 34px;
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: 8px;
        SendFormLabel { text: root.label; }
        ComboBoxField { values: root.values; current-value <=> root.current-value; horizontal-stretch: 1; }
        ListButton { width: 56px; text: "管理配置"; clicked => { root.manage-config(); } }
    }
}

export struct TaskData {
    id: string,
    name: string,
    direction: string,
    method: string,
    status: string,
    progress: string,
    ticket: string,
    destination: string,
    detail: string,
}

export struct ProfileData {
    name: string,
    kind: string,
    description: string,
}

export component MainWindow inherits Window {
    title: "ii 文件传输";
    no-frame: true;
    preferred-width: 1372px;
    preferred-height: 792px;
    min-width: 832px;
    min-height: 592px;
    background: #00000000;

    in-out property <int> page: 0;
    in-out property <[TaskData]> tasks;
    in-out property <[ProfileData]> profiles;
    in-out property <[string]> backend-profiles;
    in-out property <string> selected-profile: "";
    in-out property <string> send-path: "";
    in-out property <string> send-source-meta: "";
    in-out property <string> send-mode: "local";
    in-out property <bool> keep-sending: false;
    in-out property <bool> delete-after-receive: false;
    in-out property <bool> portable-webdav: false;
    in-out property <string> receive-ticket: "";
    in-out property <string> receive-directory: "";
    in-out property <string> status-text: "就绪";
    in-out property <string> detail-name: "未选择任务";
    in-out property <string> detail-text: "从传输队列选择任务查看详情。";
    in-out property <string> detail-ticket: "";
    in-out property <string> detail-method: "";
    in-out property <string> detail-progress: "";
    in-out property <string> detail-time: "";
    in-out property <string> detail-destination: "";
    in-out property <bool> has-selected-task: false;
    in-out property <string> profile-kind: "S3";
    in-out property <string> profile-name: "";
    in-out property <string> profile-endpoint: "";
    in-out property <string> profile-bucket: "";
    in-out property <string> profile-user: "";
    in-out property <string> profile-secret: "";
    in-out property <string> profile-provider: "generic-s3";
    in-out property <string> profile-prefix: "ii/";
    in-out property <string> profile-region: "auto";
    in-out property <string> profile-presign-ttl: "86400";
    in-out property <string> profile-webdav-auth: "Basic";
    in-out property <bool> profile-self-signed: false;
    in-out property <bool> profile-modal: false;
    in-out property <string> profile-new-kind: "S3";
    in-out property <string> database-path: "";
    in-out property <string> database-summary: "0 个任务 · 0 B";
    in-out property <string> diagnostics-text: "等待检查";
    in-out property <string> gui-version: "GUI";
    in-out property <string> cli-version: "CLI";
    in-out property <int> settings-section: 0;
    in-out property <bool> setting-check-incomplete: true;
    in-out property <bool> setting-close-to-tray: false;
    in-out property <bool> setting-open-directory: false;
    in-out property <bool> confirm-clear-history: false;

    callback set-page(int);
    callback choose-send-source();
    callback choose-receive-directory();
    callback choose-send-mode(string);
    callback start-send();
    callback start-receive();
    callback select-task(string);
    callback select-profile(string);
    callback new-profile(string);
    callback save-profile();
    callback delete-profile();
    callback open-config-directory();
    callback run-diagnostics();
    callback clear-completed();
    callback compact-database();
    callback clear-history();
    callback request-clear-history();
    callback open-github();
    callback minimize-window();
    callback maximize-window();
    callback close-window();

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #ffffff;
        border-color: #cbd6d7;
        border-width: 1px;
        border-radius: 12px;
        drop-shadow-blur: 36px;
        drop-shadow-color: #1c282d1f;
        drop-shadow-offset-y: 8px;
        clip: true;

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 48px;
                background: #fbfcfc;
                border-color: #d5dedf;
                border-width: 1px;

                Image { x: 14px; y: 11px; width: 25px; height: 25px; source: @image-url("../../logo.svg"); }
                Text { x: 45px; width: 16px; height: parent.height; text: "ii"; color: #1c282d; font-size: 14px; font-weight: 600; vertical-alignment: center; }

                NavButton { x: 76px; y: 0px; text: "传输"; active: root.page == 0; clicked => { root.set-page(0); } }
                NavButton { x: 127px; y: 0px; text: "存储"; active: root.page == 1; clicked => { root.set-page(1); } }
                NavButton { x: 178px; y: 0px; text: "诊断"; active: root.page == 2; clicked => { root.set-page(2); } }
                NavButton { x: 229px; y: 0px; text: "设置"; active: root.page == 3; clicked => { root.set-page(3); } }

                Text { x: parent.width - 430px; y: 0px; width: 80px; height: parent.height; text: root.gui-version; color: #66747b; font-size: 11px; vertical-alignment: center; }
                Rectangle { x: parent.width - 344px; y: 16px; width: 1px; height: 16px; background: #d5dedf; }
                Text { x: parent.width - 337px; y: 0px; width: 64px; height: parent.height; text: root.cli-version; color: #66747b; font-size: 11px; vertical-alignment: center; }
                HeaderThemeButton { x: parent.width - 269px; y: 8px; clicked => { root.status-text = "主题将跟随系统设置。"; } }
                Rectangle { x: parent.width - 189px; y: 20px; width: 9px; height: 9px; border-radius: 5px; background: #08766f; }
                GithubButton { x: parent.width - 171px; y: 9px; clicked => { root.open-github(); } }

                // Only the unoccupied middle section initiates an OS-level window drag.
                // Navigation, status controls, and the three window buttons keep their own input regions.
                titlebar-drag-area := TouchArea {
                    x: 330px;
                    y: 0px;
                    width: parent.width - 760px;
                    height: parent.height;
                }

                titlebar-controls := HorizontalLayout {
                    x: parent.width - 126px;
                    y: 0px;
                    width: 126px;
                    height: 48px;
                    spacing: 0px;

                    TitleBarButton { text: "−"; clicked => { root.minimize-window(); } }
                    TitleBarButton { text: "□"; clicked => { root.maximize-window(); } }
                    TitleBarButton { text: "×"; danger: true; clicked => { root.close-window(); } }
                }
            }

            Rectangle {
                y: 48px;
                width: parent.width;
                height: parent.height - 48px;
                background: #f7f9f9;

                if false: Rectangle {
                    x: 18px;
                    y: 16px;
                    width: parent.width - 36px;
                    height: parent.height - 32px;

                    VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                horizontal-stretch: 1.15;
                                background: #ffffff;
                                border-color: #d5dedf;
                                border-width: 1px;
                                border-radius: 7px;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #1c282d18;
                                drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text { text: "发送内容"; color: #1c282d; font-size: 17px; font-weight: 800; }
                                    Text { text: "选择文件或目录，创建传输码后等待接收方。"; color: #66747b; font-size: 12px; }
                                    HorizontalLayout {
                                        TextField { text <=> root.send-path; placeholder-text: "选择文件或目录"; horizontal-stretch: 1; }
                                        Button { text: "更换"; clicked => { root.choose-send-source(); } }
                                    }
                                    HorizontalLayout {
                                        Text { text: "保持发送"; color: #1c282d; vertical-alignment: center; }
                                        CheckBox { checked <=> root.keep-sending; }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Text { text: "发送方式"; color: #66747b; font-size: 12px; }
                                    HorizontalLayout {
                                        Button { text: "仅局域网"; primary: root.send-mode == "local"; clicked => { root.choose-send-mode("local"); } }
                                        Button { text: "指定中继"; primary: root.send-mode == "relay"; clicked => { root.choose-send-mode("relay"); } }
                                        Button { text: "S3"; primary: root.send-mode == "s3"; clicked => { root.choose-send-mode("s3"); } }
                                        Button { text: "WebDAV"; primary: root.send-mode == "webdav"; clicked => { root.choose-send-mode("webdav"); } }
